# Canary SRS — Environment Configuration Template
# Copy this file to .env for local development

# Environment Mode
ENVIRONMENT=development
DEBUG=true

# Server Configuration
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Configuration (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./canary.db
# DATABASE_URL=postgresql://canary_user:canary_pass@localhost:5432/canary_db

# Redis & Queue Configuration
REDIS_URL=redis://localhost:6379/0
USE_IN_MEMORY_QUEUE=true

# Storage Configuration
STORAGE_PATH=./data/storage
MAX_UPLOAD_SIZE_BYTES=10485760

# Audit Retention & Security
DEFAULT_RETENTION_DAYS=7
SECRET_KEY=dev-secret-key-change-in-production-32bytesmin
AI_SPENDING_CAP_PER_AUDIT_USD=5.00

# Optional External AI Provider (Leave empty for Offline Mode)
GEMINI_API_KEY=
